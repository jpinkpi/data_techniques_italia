class TimeSeriesDataset(Dataset):
    """
    A custom PyTorch Dataset for time series data.

    This class converts numpy arrays into PyTorch tensors and provides
    an interface for the DataLoader to iterate over the sequences.

    Args:
        X (np.ndarray): The input sequences of shape (samples, window, features).
        y (np.ndarray): The target values of shape (samples,).
    """

    def __init__(self, X, y):

        self.X = torch.tensor(X, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.float32)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return self.X[idx], self.y[idx]

