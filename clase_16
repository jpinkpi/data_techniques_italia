# 12. Training Function
"""

def train_model(model,
                train_loader,
                test_loader,
                epochs=50,
                lr=1e-3,
                device='cpu'):
    """
    Trains a PyTorch model on time series data and evaluates it on a test set.

    Args:
        model (nn.Module): The PyTorch model to train.
        train_loader (DataLoader): DataLoader for the training set.
        test_loader (DataLoader): DataLoader for the testing set.
        epochs (int): Number of training iterations over the dataset (default 50).
        lr (float): Learning rate for the Adam optimizer (default 1e-3).
        device (str): Device to run the training on ('cpu' or 'cuda').

    Returns:
        tuple: Two lists containing the average training and testing losses for each epoch.
    """
    model.to(device)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)

    train_losses = []
    test_losses = []

    for epoch in range(epochs):
        model.train()
        running_loss = 0.0
        for X_batch, y_batch in train_loader:
            X_batch = X_batch.to(device)
            y_batch = y_batch.to(device)
            predictions = model(X_batch)
            loss = criterion(predictions, y_batch)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            running_loss += loss.item()

        epoch_train_loss = running_loss / len(train_loader)

        model.eval()
        running_test_loss = 0.0
        with torch.no_grad():
            for X_batch, y_batch in test_loader:
                X_batch = X_batch.to(device)
                y_batch = y_batch.to(device)
                predictions = model(X_batch)
                loss = criterion(predictions, y_batch)
                running_test_loss += loss.item()

        epoch_test_loss = running_test_loss / len(test_loader)
        train_losses.append(epoch_train_loss)
        test_losses.append(epoch_test_loss)

        print(f'Epoch {epoch+1:3d} | train loss = {epoch_train_loss:.6f} | test loss = {epoch_test_loss:.6f}')

    return train_losses, test_losses

def train_model_on_feature(model,
                           train_loader,
                           test_loader,
                           target_feature_idx=0,
                           epochs=50,
                           lr=1e-3,
                           device='cpu'):
    """
    Trains a PyTorch model on multivariate data but minimizes the loss
    only for a specific feature index.
    """
    model.to(device)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)

    train_losses = []
    test_losses = []

    for epoch in range(epochs):
        model.train()
        running_loss = 0.0
        for X_batch, y_batch in train_loader:
            X_batch = X_batch.to(device)
            y_batch = y_batch.to(device)

            # Forward pass
            predictions = model(X_batch)

            # Ensure predictions are 2D (batch, features)
            if predictions.ndim == 1:
                predictions = predictions.unsqueeze(1)

            # Select target feature
            pred_target = predictions[:, target_feature_idx]

            loss = criterion(pred_target, y_batch)

            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            running_loss += loss.item()

        epoch_train_loss = running_loss / len(train_loader)

        # Validation
        model.eval()
        running_test_loss = 0.0
        with torch.no_grad():
            for X_batch, y_batch in test_loader:
                X_batch = X_batch.to(device)
                y_batch = y_batch.to(device)

                predictions = model(X_batch)
                if predictions.ndim == 1:
                    predictions = predictions.unsqueeze(1)

                loss = criterion(predictions[:, target_feature_idx], y_batch)
                running_test_loss += loss.item()

        epoch_test_loss = running_test_loss / len(test_loader)
        train_losses.append(epoch_train_loss)
        test_losses.append(epoch_test_loss)

        print(f'Epoch {epoch+1:3d} | Target Feature Loss (Train): {epoch_train_loss:.6f} | (Test): {epoch_test_loss:.6f}')

    return train_losses, test_losses

"""---

# 13. Evaluation Function
"""

def evaluate_model(model,
                   test_loader,
                   feature_index=None,
                   device='cpu'):
    """
    Evaluates a trained model on the test set and returns predictions and metrics.

    Args:
        model (nn.Module): The trained PyTorch model.
        test_loader (DataLoader): DataLoader for the testing set.
        device (str): Device to run evaluation on.

    Returns:
        tuple: (predictions, targets, mse)
            predictions (np.ndarray): The model's predictions.
            targets (np.ndarray): The ground truth values.
            mse (float): Mean Squared Error of the predictions.
    """
    model.eval()
    predictions = []
    targets = []

    with torch.no_grad():
        for X_batch, y_batch in test_loader:
            X_batch = X_batch.to(device)
            preds = model(X_batch)
            predictions.extend(preds.cpu().numpy())
            targets.extend(y_batch.numpy())
            if feature_index is not None:
                # ensure 2D
                #if preds.ndim == 1:
                #    predictions = predictions.unsqueeze(1)
                #if y_batch.ndim == 1:
                #    y_batch = y_batch.unsqueeze(1)
                pred_feature = predictions[:, feature_index]
                true_feature = y_batch[:, feature_index]

    predictions = np.array(predictions)
    targets = np.array(targets)
    mse = mean_squared_error(targets, predictions)

    return predictions, targets, mse

