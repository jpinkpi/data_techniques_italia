def create_sequences(data, target_column, window_size):
    """
    Converts a time series dataset into input sequences and corresponding targets.

    Args:
        data (np.ndarray): The input data array of shape (n_samples, n_features).
        target_column (int): The index of the column to be used as the prediction target.
        window_size (int): The number of previous time steps to use as input context.

    Returns:
        tuple: A tuple (X, y) where:
            X (np.ndarray): Input sequences of shape (n_samples - window_size, window_size, n_features).
            y (np.ndarray): Target values of shape (n_samples - window_size,).
    """
    X = []
    y = []

    for i in range(len(data) - window_size):

        x = data[i:i+window_size]
        target = data[i+window_size, target_column]

        X.append(x)
        y.append(target) 

    return np.array(X), np.array(y)

