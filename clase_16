def split_data(X, y, split_ratio=0.8):
    """
    Splits the data and targets into training and testing sets based on a chronological split.

    Args:
        X (np.ndarray): The input sequences of shape (samples, window, features).
        y (np.ndarray): The target values of shape (samples,).
        split_ratio (float): The proportion of data to include in the training set (default is 0.8).

    Returns:
        tuple: A tuple containing (X_train, X_test, y_train, y_test).
    """
    split = int(len(X) * split_ratio)

    X_train = X[:split]
    X_test  = X[split:]

    y_train = y[:split]
    y_test  = y[split:]

    return X_train, X_test, y_train, y_test

